# ---------------------------------------------------------------------------
# Copy to .env.local for local XAMPP development, or set each value as a real
# environment variable on your cloud host. Real environment variables take
# precedence over this file.
#
# NEVER commit a filled-in version of this file to git.
# ---------------------------------------------------------------------------

# REQUIRED - MySQL / MariaDB connection.
# Format: mysql:server=HOST;port=PORT;database=DBNAME;userId=USER;password=PASS
#
# Local XAMPP example:
DB_CONNECTION_STRING=mysql:server=127.0.0.1;port=3307;database=gamespec_optimizer;userId=root;password=
#
# Cloud example (host database is usually the private-network hostname):
# DB_CONNECTION_STRING=mysql:server=mysql.railway.internal;port=3306;database=gamespec_optimizer;userId=USER;password=PASS
DB_CONNECTION_STRING=

# REQUIRED for the RAWG catalogue lookup (Game Management -> game search).
# Get a key at https://rawg.io/apidocs
RAW_API_KEY=

# OPTIONAL - absolute path to the Python interpreter.
# Leave unset locally; the app finds .venv automatically.
# On Linux cloud hosts set this to the venv, e.g. /app/.venv/bin/python3
PYTHON_BIN=

# OPTIONAL - set to "production" on the deployed host. Informational only.
APP_ENV=